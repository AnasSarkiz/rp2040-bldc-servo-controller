{
  "name": "@tsci/AnasSarkiz.rp2040-bldc-servo-controller",
  "version": "0.0.3",
  "description": "Engineering review prototype: live JLCPCB inventory and reproducible tooling diagnostics; controller electrically incomplete",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tscircuit-cli dev index.circuit.tsx",
    "build": "tscircuit-cli build index.circuit.tsx",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write index.circuit.tsx checks",
    "format:check": "biome format index.circuit.tsx checks",
    "test:sourcing": "python3 scripts/check-sourcing.py",
    "render:sheets": "bun scripts/render-import-sheets.mjs",
    "test:schematic-sheets": "python3 scripts/check-schematic-sheets.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@tscircuit/cli": "0.1.2408",
    "tscircuit": "0.0.3016",
    "typescript": "5.9.3"
  },
  "author": "AnasSarkiz"
}
